{
  "name": "type-a-bin",
  "version": "0.1.2",
  "description": "Mock any executable binary for testing in Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SynthLuvr/type-a-bin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "==26"
  },
  "scripts": {
    "build:lib": "del-cli dist && tsc && del-cli dist/tests",
    "build": "pnpm build:lib && pnpm -r build",
    "format": "ts-canon format",
    "lint": "ts-canon lint",
    "test:lib": "vitest run --coverage",
    "test": "pnpm build:lib && pnpm test:lib && pnpm -r test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "del-cli": "^7.0.0",
    "ts-canon": "^0.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
