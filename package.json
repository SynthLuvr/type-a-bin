{
  "name": "type-a-bin",
  "version": "0.1.5",
  "description": "Mock any executable binary for testing in Node.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SynthLuvr/type-a-bin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./subprocess-coverage": {
      "types": "./dist/subprocess-coverage/index.d.ts",
      "import": "./dist/subprocess-coverage/index.js"
    },
    "./subprocess-coverage/coverage-hook.mjs": "./dist/subprocess-coverage/coverage-hook.mjs",
    "./subprocess-coverage/provider": {
      "import": "./dist/subprocess-coverage/provider.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "==26"
  },
  "scripts": {
    "build:lib": "del-cli dist && tsc && del-cli dist/tests && node scripts/copy-native.mjs && node scripts/copy-coverage-hook.mjs",
    "build": "pnpm build:lib && pnpm -r build",
    "format": "ts-canon format",
    "lint": "ts-canon lint",
    "test:lib": "tsx scripts/vitest-coverage.mts run --coverage",
    "test": "pnpm build:lib && pnpm test:lib && pnpm -r test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ast-v8-to-istanbul": "^1.0.5",
    "del-cli": "^7.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "ts-canon": "^0.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": ">= 2",
    "ast-v8-to-istanbul": ">= 1",
    "vitest": ">= 2"
  },
  "peerDependenciesMeta": {
    "@vitest/coverage-v8": {
      "optional": true
    },
    "ast-v8-to-istanbul": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
